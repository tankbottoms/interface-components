{
  "name": "interface-components",
  "version": "1.16.0",
  "description": "Documentation and live demos for magx draggable panel components and sparkline charts, built with Lit 3 and SvelteKit.",
  "author": "M.P.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error --watch",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test tools/oxlint/anti-slop/rules/*.test.ts",
    "qa": "bun run tools/qa/responsive.ts",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^26.3.0",
    "oxlint": "1.78.0",
    "playwright": "^1.59.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "lit": "^3.0.0"
  }
}
